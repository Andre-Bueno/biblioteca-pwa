# Protect this file once filled in: chmod 600 .env (it holds SECRET_KEY).
# Copy to .env at the repo root (never commit it) and fill in.
# `docker compose` reads .env from the compose file directory (infra/), NOT the repo root, so run:
#   docker compose -f infra/compose.example.yml --env-file .env up
# (from the repo root) or, from infra/:  docker compose --env-file ../.env ...
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Required. >= 32 chars, >= 12 distinct chars, no leading/trailing spaces and not a short
# repeated block; the app refuses to start otherwise.
SECRET_KEY=

# Host address/port the container is published on (default: loopback only).
# Set BIND_ADDRESS=0.0.0.0 only if no reverse proxy on this host fronts the app.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# Optional. The app serves the frontend itself, so the browser calls the API on the same origin
# and this can stay empty (the CSRF check then compares Origin/Referer with the request Host:
# your proxy must forward the original Host header). Set a JSON list of exact origins only if the
# frontend is hosted on ANOTHER origin (no "*", no path, no trailing slash), e.g.:
# ALLOWED_ORIGINS=["https://reader.example.com"]
ALLOWED_ORIGINS=

# REQUIRED (no default: compose and the image refuse to start while it is empty).
# IP/CIDR (comma-separated) of the reverse proxy that connects to the container, trusted to set
# X-Forwarded-* (uvicorn --forwarded-allow-ips). This is the ONLY source of the real client IP.
# A wrong value is not harmless: if the proxy is not listed every client looks like the proxy,
# so any one client can lock the login for everybody; if it is too broad clients can forge theirs.
# The compose file pins the project network to NETWORK_SUBNET (default 172.30.77.0/24), so the
# address of the host gateway does not change across `down`/`up`:
#   - proxy on the host (published port 127.0.0.1:HOST_PORT): FORWARDED_ALLOW_IPS=172.30.77.0/24
#     (the gateway, 172.30.77.1, is inside it). If you changed NETWORK_SUBNET, use that CIDR.
#   - proxy in another container on the same network: that container IP or the same CIDR.
#   - to verify: the uvicorn access log shows the client address of each request; behind the
#     proxy that address is the one to list here (every request showing the same address
#     means the proxy is not listed yet).
# FIRST BOOT: the compose file refuses to start without it. Start once with FORWARDED_ALLOW_IPS=*
# and BIND_ADDRESS=127.0.0.1 (port not reachable from outside), find the proxy address as above,
# then set the real value and recreate the container (docs/DEPLOY.md).
# "*" ONLY if the published port is NOT reachable directly (loopback bind behind the proxy);
# otherwise any client could forge its IP. The app logs a warning at startup when this is empty
# or "*".
FORWARDED_ALLOW_IPS=

# true in production (HTTPS). Controls the Secure flag of the session and CSRF cookies.
# false ONLY to try the app locally over plain http://localhost (browsers drop Secure cookies on
# http, so login would not stick). Never false in production.
COOKIE_SECURE=true

# Project network (fixed so the gateway address never changes) and container limits.
# NETWORK_SUBNET=172.30.77.0/24
# STOP_GRACE_PERIOD=30s
# PIDS_LIMIT=256
# MEMORY_LIMIT=1g

# Release of the published image to run: ghcr.io/andre-bueno/biblioteca-pwa:<APP_TAG>.
# Default (when unset): latest = newest final release. Pin a tag (e.g. v0.1.0) to stay on a known
# version; the update webhook receiver (infra/deploy-hook) rewrites this line, and rolling back is
# putting the previous tag here. Pre-releases (v0.2.0-rc.1) are never "latest": pin them by tag.
# Then: docker compose ... pull && docker compose ... up -d   (docs/DEPLOY.md, "Atualizacoes por release")
# APP_TAG=v0.1.0

# Host folder with the library (mangas, books, PDFs), mounted read-only at /library.
# Default (when unset): ../library relative to infra/, i.e. <repo root>/library.
# LIBRARY_HOST_PATH=/srv/library

# Covers and descriptions from PUBLIC sources (the only outbound network use of the app).
# Only the cleaned series title is sent, to a FIXED list of hosts (MangaDex and AniList), over
# https, with a generic User-Agent; nothing about users, files or this server. An admin triggers
# it (POST /api/v1/library/enrich, or `python -m app.cli enrich [--series ID] [--force]`).
# METADATA_ENABLED=false switches off ALL external access (manual editing keeps working).
# METADATA_ENABLED=true
# Order of preference of the sources (known: mangadex, anilist) and description languages.
# METADATA_PROVIDERS=mangadex,anilist,wikipedia,googlebooks
# (mangadex/anilist: cover + description; wikipedia = pt.wikipedia.org and googlebooks = Google
# Books: Portuguese description only, used only on a strong title match; Wikipedia text is
# CC BY-SA 4.0 and is shown with its attribution.)
# Last resort when no Portuguese text exists: automatic English -> Portuguese translation of the
# public synopsis (api.mymemory.translated.net, small anonymous daily quota), shown as "translated".
# METADATA_TRANSLATE_ENABLED=true
# METADATA_LANGUAGES=pt-br,pt,en
# Whole-request timeout in seconds (1-60) and series handled per run (1-1000).
# METADATA_HTTP_TIMEOUT_SECONDS=15
# METADATA_MAX_PER_RUN=25
# Writable folder for downloaded covers (<DATA_DIR>/covers). The image uses /data (the volume).
# DATA_DIR=/data

# New-release notice + update by webhook. The running version is APP_VERSION (set by the image;
# "dev" or a non-semver value switches the check off). Admins see a notice when a newer final
# release exists on GitHub (api.github.com, a fixed host, no token, a few requests per day); if an
# admin approves, the app sends a SIGNED request to YOUR deploy agent (infra/deploy-hook); the app
# never touches Docker. The URL and the secret are configuration only (no endpoint changes them);
# the secret (>= 32 chars, the same as UPDATE_HOOK_SECRET of the receiver) goes to a safe place.
# Both must be set together. http is accepted only with ALLOW_HTTP and only for a loopback, private
# or Tailscale (100.64.0.0/10) destination; https is always accepted.
# UPDATE_CHECK_ENABLED=true
# UPDATE_REPOSITORY=Andre-Bueno/biblioteca-pwa
# UPDATE_CHECK_INTERVAL_HOURS=6
# UPDATE_WEBHOOK_URL=https://deploy.example.com/update
# UPDATE_WEBHOOK_SECRET=
# UPDATE_WEBHOOK_ALLOW_HTTP=false

# Optional tuning (defaults shown; the image sets DATABASE_URL=/data/app.db, LIBRARY_PATH=/library, FRONTEND_DIST_DIR=/app/static).
# Migrations run on every container start. Create the first admin (password is prompted, never
# passed as argument; -it is required):
#   docker compose -f infra/compose.example.yml --env-file .env exec -it backend python -m app.cli create-user <username> --admin
# Sessions: short access token, rotating refresh token, absolute session lifetime (90 days).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# SESSION_ABSOLUTE_TTL_SECONDS=7776000
# A refresh token presented again within this many seconds of its first use (two tabs, a retry
# after a lost response) gets a sibling session instead of being treated as theft (0 = off, max 60).
# REFRESH_REUSE_GRACE_SECONDS=10
# Audit events older than this are purged (login/refresh, or `python -m app.cli purge`).
# AUDIT_RETENTION_DAYS=180
# uvicorn limits applied by the image (see infra/Dockerfile).
# UVICORN_LIMIT_CONCURRENCY=100
# UVICORN_TIMEOUT_KEEP_ALIVE=5
# UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=20
# Login lockout (progressive: LOCKOUT_SECONDS, doubling up to LOCKOUT_MAX_SECONDS):
#   MAX_FAILURES_ACCOUNT        per (client address, account) pair: the primary account limit
#   MAX_FAILURES_ACCOUNT_ALL_IPS per account across all addresses (skipped for addresses with a
#                               successful login for that account in the last TRUSTED window)
#   MAX_FAILURES_IP             per client address, any account
# LOGIN_MAX_FAILURES_ACCOUNT=5
# LOGIN_MAX_FAILURES_ACCOUNT_ALL_IPS=15
# LOGIN_MAX_FAILURES_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=300
# LOGIN_LOCKOUT_MAX_SECONDS=3600
# LOGIN_TRUSTED_IP_WINDOW_SECONDS=2592000
# Rate limit per client IP (in-memory token bucket, per process). /api/v1/auth/* is stricter
# and also counts against the global /api limit. PER_MINUTE = sustained rate, BURST = bucket size.
# RATE_LIMIT_API_PER_MINUTE=600
# RATE_LIMIT_API_BURST=200
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_AUTH_BURST=10
