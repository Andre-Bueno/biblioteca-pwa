# Copy to .env at the repo root (never commit it) and fill in.
# `docker compose` reads .env from the compose file directory (infra/), NOT the repo root, so run:
#   docker compose -f infra/compose.example.yml --env-file .env up
# (from the repo root) or, from infra/:  docker compose --env-file ../.env ...
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Required. >= 32 chars, >= 12 distinct chars, no leading/trailing spaces and not a short
# repeated block; the app refuses to start otherwise.
SECRET_KEY=

# Host address/port the container is published on (default: loopback only).
# Set BIND_ADDRESS=0.0.0.0 only if no reverse proxy on this host fronts the app.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# JSON list of allowed browser origins (exact match, no "*").
ALLOWED_ORIGINS=["https://reader.example.com"]

# IPs/CIDRs of the reverse proxy trusted to set X-Forwarded-* (uvicorn --forwarded-allow-ips).
# This is the ONLY source of the real client IP.
# Inside a container, a proxy running on the HOST reaches the app through the bridge gateway
# (typically 172.17.0.1, or the 172.16.0.0/12 range), NEVER through 127.0.0.1.
# Find it with:  docker network inspect bridge --format "{{(index .IPAM.Config 0).Gateway}}"
# (or the compose project network's gateway/subnet), or check the source IP in the app logs.
# "*" is acceptable ONLY if the published port is NOT reachable directly (e.g. loopback bind
# behind the proxy); otherwise any client could forge its IP.
FORWARDED_ALLOW_IPS=172.17.0.1

# true in production (HTTPS).
COOKIE_SECURE=true
