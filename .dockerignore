# Build context is the repository root (see infra/compose.example.yml). The frontend sources are part of
# the context (built in stage 1 of infra/Dockerfile), minus node_modules, dist and tests.
**/.venv
**/venv
**/node_modules
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.import_linter_cache
**/.coverage
**/htmlcov
**/*.egg-info
.env
.env.*
**/.env
**/.env.*
!.env.example
.git
.gitignore
.claude
.idea
.vscode
docs
scripts
frontend/node_modules
frontend/dist
frontend/tests
frontend/test-results
frontend/playwright-report
backend/tests
**/dist
**/*.db
**/*.sqlite
**/*.sqlite3
library
data
# infra/: only what the image needs (constraints and entrypoint) goes in; the rest stays out.
infra/*
!infra/constraints.txt
!infra/entrypoint.sh
**/*.md
